<main>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-content">
                    <h1><%= t(".hero_title") %></h1>
                    <p><%= t(".hero_subtitle") %></p>
                    <%= render "request_access", form_id: "request_access_hero" %>
                    <p class="sign-in-link"><%= link_to t(".sign_in_link"), new_session_path %></p>
                </div>
                <div class="notice-board" role="img" aria-label="<%= t(".hero_img_alt") %>">
                    <!-- Discussion Card -->
                    <div class="notice-card card-discussion">
                        <div class="card-header">
                            <span class="card-title"><%= t(".hero_card1_title") %></span>
                        </div>
                        <div class="card-content">
                            <%= t(".hero_card1_content") %>
                        </div>
                        <div class="card-meta">
                            <span><%= t(".hero_card1_author") %></span>
                            <span class="upvote-count">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M6 2L10 7H2L6 2Z" fill="currentColor"/>
                                </svg>
                                3
                            </span>
                        </div>
                    </div>
                    
                    <!-- Announcement Card -->
                    <div class="notice-card card-announcement">
                        <div class="card-header">
                            <span class="card-title"><%= t(".hero_card2_title") %></span>
                            <span class="card-badge badge-staff"><%= t(".hero_card2_badge") %></span>
                        </div>
                        <div class="card-content">
                            <%= t(".hero_card2_content") %>
                        </div>
                    </div>
                    
                    <!-- Service Card -->
                    <div class="notice-card card-service">
                        <div class="card-header">
                            <span class="card-title"><%= t(".hero_card3_title") %></span>
                            <span class="card-badge badge-category"><%= t(".hero_card3_category") %></span>
                        </div>
                        <div class="card-content">
                            <%= t(".hero_card3_content") %>
                        </div>
                        <div class="card-meta">
                            <span><%= t(".hero_card3_recommended_by") %></span>
                            <span class="vouch-count">8 <%= t(".hero_card3_vouches") %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features">
        <!-- Feature 1: Discussions -->
        <div class="features-section">
            <div class="feature-row" data-controller="scroll-reveal">
                <div class="feature-content">
                    <h2><%= t(".feature1_title") %></h2>
                    <p><%= t(".feature1_text") %></p>
                    <ul class="feature-list">
                        <li><%= t(".feature1_list1") %></li>
                        <li><%= t(".feature1_list2") %></li>
                        <li><%= t(".feature1_list3") %></li>
                    </ul>
                </div>
                <div class="feature-image-container">
                    <div class="app-mockup" role="img" aria-label="<%= t(".feature1_img_alt") %>">
                        <div class="mockup-header" aria-hidden="true">CondoHub</div>
                        <div class="mockup-body" aria-hidden="true">
                            <div class="mockup-post">
                                <div class="mockup-upvote">
                                    <div class="mockup-upvote-arrow" aria-hidden="true">▲</div>
                                    <span>3</span>
                                </div>
                                <div class="mockup-content">
                                    <div class="mockup-line w1"></div>
                                    <div class="mockup-line w2"></div>
                                    <div class="mockup-line w3"></div>
                                </div>
                            </div>
                            <div class="mockup-post">
                                <div class="mockup-upvote">
                                    <div class="mockup-upvote-arrow" aria-hidden="true">▲</div>
                                    <span>5</span>
                                </div>
                                <div class="mockup-content">
                                    <div class="mockup-line w1"></div>
                                    <div class="mockup-line w2"></div>
                                    <div class="mockup-line w3"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feature 2: Announcements -->
        <div class="features-section">
            <div class="feature-row" data-controller="scroll-reveal">
                <div class="feature-content">
                    <h2><%= t(".feature2_title") %></h2>
                    <p><%= t(".feature2_text") %></p>
                    <ul class="feature-list">
                        <li><%= t(".feature2_list1") %></li>
                        <li><%= t(".feature2_list2") %></li>
                        <li><%= t(".feature2_list3") %></li>
                    </ul>
                </div>
                <div class="feature-image-container">
                    <div class="app-mockup" role="img" aria-label="<%= t(".feature2_img_alt") %>">
                        <div class="mockup-header" aria-hidden="true">CondoHub</div>
                        <div class="mockup-body" aria-hidden="true">
                            <div class="mockup-announcement">
                                <span class="mockup-badge"><%= t(".feature2_badge") %></span>
                                <div class="mockup-content" style="margin-top: 0.5rem;">
                                    <div class="mockup-line w4"></div>
                                    <div class="mockup-line w2"></div>
                                    <div class="mockup-line w5"></div>
                                    <div class="mockup-line w3"></div>
                                </div>
                            </div>
                            <div class="mockup-post" style="opacity: 0.5;">
                                <div class="mockup-upvote">
                                    <div class="mockup-upvote-arrow" aria-hidden="true">▲</div>
                                    <span>2</span>
                                </div>
                                <div class="mockup-content">
                                    <div class="mockup-line w1"></div>
                                    <div class="mockup-line w2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Feature 3: Services -->
        <div class="features-section">
            <div class="feature-row" data-controller="scroll-reveal">
                <div class="feature-content">
                    <h2><%= t(".feature3_title") %></h2>
                    <p><%= t(".feature3_text") %></p>
                    <ul class="feature-list">
                        <li><%= t(".feature3_list1") %></li>
                        <li><%= t(".feature3_list2") %></li>
                        <li><%= t(".feature3_list3") %></li>
                    </ul>
                </div>
                <div class="feature-image-container">
                    <div class="app-mockup" role="img" aria-label="<%= t(".feature3_img_alt") %>">
                        <div class="mockup-header" aria-hidden="true">CondoHub</div>
                        <div class="mockup-body" aria-hidden="true">
                            <div class="mockup-service">
                                <div>
                                    <span class="mockup-service-category"><%= t(".feature3_service_cat1") %></span>
                                    <div style="margin-top: 0.3rem;">
                                        <div class="mockup-line w1"></div>
                                        <div class="mockup-line w3"></div>
                                    </div>
                                </div>
                                <div class="mockup-service-vouch">8 <%= t(".feature3_vouches") %></div>
                            </div>
                            <div class="mockup-service">
                                <div>
                                    <span class="mockup-service-category"><%= t(".feature3_service_cat2") %></span>
                                    <div style="margin-top: 0.3rem;">
                                        <div class="mockup-line w1"></div>
                                        <div class="mockup-line w3"></div>
                                    </div>
                                </div>
                                <div class="mockup-service-vouch">12 <%= t(".feature3_vouches") %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="cta-section">
        <div class="container">
            <h2><%= t(".cta_title") %></h2>
            <p><%= t(".cta_text") %></p>
            <%= render "request_access", form_id: "request_access_cta" %>
        </div>
    </section>
</main>
