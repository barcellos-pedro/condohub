<div class="comment-card" id="<%= dom_id(comment) %>">
  <div class="comment-header">
    <div class="comment-meta">
      <strong><%= link_to(comment.user&.full_name || t("topics.show.unknown_user"), comment.user ? resident_path(comment.user) : "#", class: "author-link", data: { turbo_frame: "_top" }) %></strong>
      <span class="badge badge-<%= comment.user&.role || 'resident' %>" style="font-size: 0.55rem; padding: 0.1rem 0.3rem;"><%= t("roles.#{comment.user&.role || 'resident'}") %></span>
      <span style="color: var(--text-muted);">•</span>
      <span style="color: var(--text-muted);"><%= time_ago_in_words(comment.created_at) %> <%= t("topics.show.ago") %></span>
    </div>

    <div class="comment-actions">
      <% upvoted = comment.upvotes.exists?(user: current_user) %>
      <%= button_to topic_comment_upvote_path(topic_id: topic, comment_id: comment), method: :post, class: "btn btn-secondary btn-comment-action #{upvoted ? 'upvoted' : ''}", style: "padding: 0.25rem 0.5rem; font-size: 0.75rem;", aria: { label: "#{t('topics.show.upvote')} (#{comment.upvotes_count})" } do %>
        ▲ <%= comment.upvotes_count %>
      <% end %>

      <% if comment.user == current_user %>
        <%= link_to t("topics.show.edit_comment"),
                    edit_topic_comment_path(topic_id: topic, id: comment),
                    class: "btn btn-secondary btn-comment-action" %>
        <%= button_to t("topics.show.delete_comment"),
                      topic_comment_path(topic_id: topic, id: comment),
                      method: :delete,
                      form: { class: "comment-action-form", data: { turbo_confirm: t("topics.show.delete_comment_confirm") } },
                      class: "btn btn-danger btn-comment-action" %>
      <% end %>
    </div>
  </div>

  <div class="comment-body">
    <%= comment.content %>
  </div>
</div>
