<%= form_with model: topic, local: true do |form| %>
  <% if topic.errors.any? %>
    <div class="form-error" style="margin-bottom: 1rem; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid var(--danger); border-radius: 0.375rem; color: var(--danger); font-size: 0.875rem;">
      <%= topic.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form.hidden_field :topic_type %>

  <div class="form-group">
    <%= form.label :title, t("topics.form.title_label"), class: "form-label" %>
    <%= form.text_field :title, required: true, placeholder: t("topics.form.title_placeholder"), class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :content, t("topics.form.content_label"), class: "form-label" %>
    <%= form.text_area :content, required: true, rows: 4, placeholder: t("topics.form.content_placeholder"), class: "form-input" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
    <% if topic.persisted? %>
      <%= link_to t("topics.form.cancel"), topic_path(topic), class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit t("topics.form.submit"), class: "btn btn-primary" %>
  </div>
<% end %>
