<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t(".title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t(".app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="<%= t(".description") %>">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://condo-hub.live">
    <meta property="og:title" content="<%= content_for(:title) || t(".title") %>">
    <meta property="og:description" content="<%= t(".description") %>">
    <meta property="og:image" content="https://condo-hub.live/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:domain" content="condo-hub.live">
    <meta name="twitter:title" content="<%= content_for(:title) || t(".title") %>">
    <meta name="twitter:url" content="https://condo-hub.live">
    <meta name="twitter:description" content="<%= t(".description") %>">
    <meta name="twitter:image" content="https://condo-hub.live/og-image.png">

    <%= yield :head %>

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <link rel="shortcut icon" href="/favicon.ico">

    <!-- PWA / Platform support -->
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/apple-touch-icon.svg" color="#5bbad5">

    <meta name="theme-color" content="#ffffff">

    <%# Include custom styling after base app styling %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content" class="skip-link"><%= t(".skip_to_content") %></a>

    <% if authenticated? %>
      <header class="app-header">
        <a href="<%= dashboard_path %>" class="logo">
          <%= t(".app_name") %>
        </a>

        <div class="locale-switcher" data-controller="locale-switcher">
          <%= select_tag nil,
                options_for_select(
                  {
                    t("locales.en") => "en",
                    t("locales.pt-BR") => "pt-BR",
                    t("locales.es") => "es",
                    t("locales.ko") => "ko"
                  },
                  I18n.locale.to_s
                ),
                aria: { label: t(".select_language") },
                data: { locale_switcher_target: "select", action: "locale-switcher#change" },
                class: "locale-select" %>
        </div>
        
        <div class="user-nav-card">
          <div class="user-nav-info">
            <div class="user-nav-name"><%= link_to current_user.full_name, edit_profile_path, class: "profile-link", style: "color: inherit; text-decoration: none;" %></div>
            <div class="user-nav-meta">
              <span class="badge badge-<%= current_user.role %>"><%= t("roles.#{current_user.role}") %></span>
              <span>•</span>
              <strong style="color: var(--primary-accent);"><%= current_condominium.name %></strong>
            </div>
          </div>
          
          <button data-controller="theme" data-action="theme#toggle" class="btn btn-secondary" style="padding: 0.4rem 0.6rem; font-size: 1rem; line-height: 1;" aria-label="<%= t('.toggle_theme') %>">
            <span data-theme-target="icon">☀️</span>
          </button>

          <%= button_to t(".log_out"), session_path, method: :delete, class: "btn btn-danger", style: "padding: 0.4rem 0.8rem; font-size: 0.8rem;" %>
        </div>
      </header>
    <% end %>

    <% if flash.any? %>
      <div class="flash-container" aria-live="polite" role="status">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>">
            <span><%= message %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="main-content">
      <%= yield %>
    </main>
  </body>
</html>
