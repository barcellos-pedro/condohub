<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CondoHub | <%= t("landing.index.tagline") %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="<%= t("landing.index.meta_description") %>">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://condo-hub.live">
    <meta property="og:title" content="CondoHub | <%= t("landing.index.tagline") %>">
    <meta property="og:description" content="<%= t("landing.index.meta_description") %>">
    <meta property="og:image" content="https://condo-hub.live/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:domain" content="condo-hub.live">
    <meta name="twitter:title" content="CondoHub | <%= t("landing.index.tagline") %>">
    <meta name="twitter:url" content="https://condo-hub.live">
    <meta name="twitter:description" content="<%= t("landing.index.meta_description") %>">
    <meta name="twitter:image" content="https://condo-hub.live/og-image.png">
    
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/favicon.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
</head>
<body>

    <header class="landing-header">
        <div class="container nav-container">
            <div class="nav-left">
                <a href="<%= root_path %>" class="logo"><span translate="no">CondoHub</span></a>
                <div class="locale-switcher-landing" data-controller="locale-switcher">
                    <%= select_tag nil,
                        options_for_select(
                            {
                                t("locales.en") => "en",
                                t("locales.pt-BR") => "pt-BR",
                                t("locales.es") => "es",
                                t("locales.ko") => "ko"
                            },
                            I18n.locale.to_s
                        ),
                        aria: { label: t("landing.index.select_language") },
                        data: { locale_switcher_target: "select", action: "locale-switcher#change" } %>
                </div>
            </div>
            <%= link_to t("landing.index.get_started"), dashboard_path(locale: I18n.locale), class: "btn" %>
        </div>
    </header>

    <%= yield %>

    <footer>
        <div class="container">
            <p>&copy; 2026 <span translate="no">CondoHub</span>. <%= t("landing.index.footer") %></p>
        </div>
    </footer>
</body>
</html>
