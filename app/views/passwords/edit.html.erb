<h1><%= t(".title") %></h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

<%= form_with url: password_path(params[:token]), method: :put do |form| %>
  <%= form.label :password, t(".password_label"), style: "display: block; margin-bottom: 0.5rem; font-weight: 500;" %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t(".password_placeholder"), maxlength: 72 %><br>
  <%= form.label :password_confirmation, t(".password_confirmation_label"), style: "display: block; margin-bottom: 0.5rem; font-weight: 500;" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t(".password_confirmation_placeholder"), maxlength: 72 %><br>
  <%= form.submit t(".submit") %>
<% end %>
