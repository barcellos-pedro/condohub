<div class="container">
  <div class="dashboard-layout">
    
    <!-- Sidebar -->
    <aside class="sidebar-card">
      <h1 class="condo-card-title"><%= current_condominium.name %></h1>
      <p class="condo-card-address">📍 <%= current_condominium.address.presence || t(".no_address") %></p>

      <% if current_condominium.whatsapp_group_link.present? %>
        <p class="condo-card-whatsapp">
          <a href="<%= current_condominium.whatsapp_group_link %>" target="_blank" rel="noopener" class="whatsapp-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" fill="currentColor"/>
            </svg>
            WhatsApp Group
          </a>
        </p>
      <% end %>

      <% if current_user.admin? %>
        <p class="condo-card-settings">
          <%= link_to t(".metrics"), condominium_path, class: "settings-link" %>
          <%= link_to t(".condo_settings"), edit_condominium_path, class: "settings-link" %>
          <%= link_to t(".invite_resident"), new_invitation_path, class: "settings-link" %>
        </p>
      <% end %>

      <nav class="tab-nav">
        <%= link_to dashboard_path(tab: 'discussions'), class: "tab-link #{@tab == 'discussions' ? 'active' : ''}" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <%= t(".discussions_tab") %>
        <% end %>
        
        <%= link_to dashboard_path(tab: 'announcements'), class: "tab-link #{@tab == 'announcements' ? 'active' : ''}" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-5v12L3 13v-2z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
          <%= t(".announcements_tab") %>
        <% end %>
        
        <%= link_to dashboard_path(tab: 'services'), class: "tab-link #{@tab == 'services' ? 'active' : ''}" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <%= t(".services_tab") %>
        <% end %>
      </nav>
      
      <% if Rails.env.development? %>
        <div style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
          <span style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700;"><%= t(".sandbox_mode") %></span>
          <%= link_to t(".switch_persona"), new_session_path, class: "btn btn-secondary", style: "width: 100%; font-size: 0.8rem; padding: 0.5rem;" %>
        </div>
      <% end %>
    </aside>

    <!-- Main Content Area -->
    <main>
      
      <% if @tab == 'discussions' %>
        <!-- TAB: DISCUSSIONS -->
        <div class="feed-header">
          <h2 class="feed-title"><%= t(".resident_discussions") %></h2>
        </div>

        <%= form_with url: dashboard_path, method: :get, local: true, class: "search-form" do |f| %>
          <%= hidden_field_tag :tab, @tab %>
          <%= hidden_field_tag :sort, @sort if @sort.present? %>
          <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <%= text_field_tag :q, @query, placeholder: t("search.placeholder"), class: "form-input", aria: { label: t("search.label") } %>
          </div>
        <% end %>

        <div class="sort-controls">
          <% %w[popular recent unanswered].each do |s| %>
            <%= link_to t("sort.#{s}"), dashboard_path(tab: @tab, sort: s, q: @query),
                class: "sort-link #{(@sort == s || (@sort.blank? && s == 'popular')) ? 'active' : ''}" %>
          <% end %>
        </div>

        <!-- Create new topic form -->
        <div class="creator-card" data-controller="compose">
          <div class="compose-trigger" data-compose-target="trigger" data-action="click->compose#expand focus->compose#expand" tabindex="0">
            <%= t(".share_something") %>
          </div>
          <div data-compose-target="form" hidden>
            <h3 class="creator-title"><%= t(".share_something") %></h3>
            <%= render "topics/form", topic: @new_topic %>
            <div style="margin-top: 0.5rem;">
              <button type="button" class="btn btn-secondary" data-action="click->compose#collapse"><%= t("topics.form.cancel") %></button>
            </div>
          </div>
        </div>

        <!-- Topics Feed -->
        <% if @topics.any? %>
          <% @topics.each do |topic| %>
            <%= render topic %>
          <% end %>
          <%= render "shared/pagination",
              has_more: @has_more_topics,
              label: t("load_more"),
              url_params: dashboard_path(tab: "discussions", page: @next_page, q: @query, sort: @sort) %>
        <% else %>
          <div style="text-align: center; padding: 3rem; color: var(--text-secondary);">
            <%= t(".no_discussions") %>
          </div>
        <% end %>

      <% elsif @tab == 'announcements' %>
        <!-- TAB: ANNOUNCEMENTS -->
        <div class="feed-header">
          <h2 class="feed-title"><%= t(".management_announcements") %></h2>
          <span class="badge badge-announcement" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;"><%= t(".official_only") %></span>
        </div>

        <%= form_with url: dashboard_path, method: :get, local: true, class: "search-form" do |f| %>
          <%= hidden_field_tag :tab, @tab %>
          <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <%= text_field_tag :q, @query, placeholder: t("search.placeholder"), class: "form-input", aria: { label: t("search.label") } %>
          </div>
        <% end %>

        <!-- Create new announcement (Admins only) -->
        <% if current_user.admin? %>
          <div class="creator-card" style="border-left: 4px solid var(--warning);" data-controller="compose">
            <div class="compose-trigger" data-compose-target="trigger" data-action="click->compose#expand focus->compose#expand" tabindex="0" style="color: var(--warning);">
              <%= t(".publish_heading") %>
            </div>
            <div data-compose-target="form" hidden>
              <h3 class="creator-title" style="color: var(--warning);"><%= t(".publish_heading") %></h3>
              <%= render "topics/form", topic: @new_topic %>
              <div style="margin-top: 0.5rem;">
                <button type="button" class="btn btn-secondary" data-action="click->compose#collapse"><%= t("topics.form.cancel") %></button>
              </div>
            </div>
          </div>
        <% else %>
          <div class="creator-card" style="background: rgba(245, 158, 11, 0.03); border: 1px dashed rgba(245, 158, 11, 0.2); text-align: center; color: var(--warning); font-size: 0.9rem;">
            <%= t(".announcements_readonly") %>
          </div>
        <% end %>

        <!-- Announcements Feed -->
        <% if @topics.any? %>
          <% @topics.each do |topic| %>
            <%= render topic %>
          <% end %>
          <%= render "shared/pagination",
              has_more: @has_more_topics,
              label: t("load_more"),
              url_params: dashboard_path(tab: "announcements", page: @next_page, q: @query) %>
        <% else %>
          <div style="text-align: center; padding: 3rem; color: var(--text-secondary);">
            <%= t(".no_announcements") %>
          </div>
        <% end %>

      <% elsif @tab == 'services' %>
        <!-- TAB: LOCAL SERVICES -->
        <div class="feed-header">
          <h2 class="feed-title"><%= t(".trusted_services") %></h2>
        </div>

        <%= form_with url: dashboard_path, method: :get, local: true, class: "search-form" do |f| %>
          <%= hidden_field_tag :tab, @tab %>
          <%= hidden_field_tag :sort, @sort if @sort.present? %>
          <%= hidden_field_tag :category, @category if @category.present? %>
          <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <%= text_field_tag :q, @query, placeholder: t("search.placeholder"), class: "form-input", aria: { label: t("search.label") } %>
          </div>
        <% end %>

        <div class="category-filters">
          <%= link_to t("filters.all"), dashboard_path(tab: "services", q: @query),
              class: ("active" if @category.blank?) %>
          <% ServiceListing::CATEGORIES.each do |cat| %>
            <%= link_to t("categories.#{cat}"), dashboard_path(tab: "services", category: cat, q: @query),
                class: ("active" if @category == cat) %>
          <% end %>
        </div>

        <div class="sort-controls">
          <% %w[popular recent].each do |s| %>
            <%= link_to t("sort.#{s}"), dashboard_path(tab: @tab, sort: s, q: @query, category: @category),
                class: "sort-link #{(@sort == s || (@sort.blank? && s == 'popular')) ? 'active' : ''}" %>
          <% end %>
        </div>

        <!-- Recommend new service form -->
        <div class="creator-card" data-controller="compose">
          <div class="compose-trigger" data-compose-target="trigger" data-action="click->compose#expand focus->compose#expand" tabindex="0">
            <%= t(".recommend_service") %>
          </div>
          <div data-compose-target="form" hidden>
            <h3 class="creator-title"><%= t(".recommend_service") %></h3>
            <%= render "service_listings/form", service_listing: @new_service %>
            <div style="margin-top: 0.5rem;">
              <button type="button" class="btn btn-secondary" data-action="click->compose#collapse"><%= t("topics.form.cancel") %></button>
            </div>
          </div>
        </div>

        <!-- Services Feed -->
        <% if @services.any? %>
          <% @services.each do |service| %>
            <%= render service %>
          <% end %>
          <%= render "shared/pagination",
              has_more: @has_more_services,
              label: t("load_more"),
              url_params: dashboard_path(tab: "services", page: @next_page, q: @query, category: @category, sort: @sort) %>
        <% else %>
          <div style="text-align: center; padding: 3rem; color: var(--text-secondary);">
            <%= t(".no_services") %>
          </div>
        <% end %>

      <% end %>

    </main>
  </div>
</div>
