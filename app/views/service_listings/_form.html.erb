<%= form_with model: service_listing, local: true do |form| %>
  <% if service_listing.errors.any? %>
    <div class="form-error" style="margin-bottom: 1rem; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid var(--danger); border-radius: 0.375rem; color: var(--danger); font-size: 0.875rem;">
      <%= service_listing.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="condo-switcher-grid" style="gap: 1rem; margin-bottom: 1rem;">
    <div class="form-group" style="margin-bottom: 0;">
      <%= form.label :title, t("service_listings.form.title_label"), class: "form-label" %>
      <%= form.text_field :title, required: true, placeholder: t("service_listings.form.title_placeholder"), class: "form-input" %>
    </div>

    <div class="form-group" style="margin-bottom: 0;">
      <%= form.label :category, t("service_listings.form.category_label"), class: "form-label" %>
      <%= form.text_field :category, required: true, placeholder: t("service_listings.form.category_placeholder"), class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :contact_info, t("service_listings.form.contact_info_label"), class: "form-label" %>
    <%= form.text_field :contact_info, required: true, placeholder: t("service_listings.form.contact_info_placeholder"), class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :description, t("service_listings.form.description_label"), class: "form-label" %>
    <%= form.text_area :description, required: true, rows: 2, placeholder: t("service_listings.form.description_placeholder"), class: "form-input" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
    <% if service_listing.persisted? %>
      <%= link_to t("service_listings.form.cancel"), dashboard_path(tab: "services"), class: "btn btn-secondary" %>
    <% end %>
    <%= form.submit t("service_listings.form.submit"), class: "btn btn-primary" %>
  </div>
<% end %>
