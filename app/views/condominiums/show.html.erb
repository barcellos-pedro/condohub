<div class="container">
  <div class="settings-card">
    <h1 style="color: var(--text-primary);"><%= t(".title") %></h1>
    <p style="color: var(--text-secondary);"><%= current_condominium.name %></p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
      <div class="post-card" style="align-items: center;">
        <div style="font-size: 2rem; font-weight: 800; color: var(--primary-accent);"><%= @metrics[:total_residents] %></div>
        <div style="color: var(--text-secondary); font-size: 0.85rem;"><%= t(".total_residents") %></div>
      </div>

      <div class="post-card" style="align-items: center;">
        <div style="font-size: 2rem; font-weight: 800; color: var(--success);"><%= @metrics[:active_residents] %></div>
        <div style="color: var(--text-secondary); font-size: 0.85rem;"><%= t(".active_residents") %></div>
      </div>

      <div class="post-card" style="align-items: center;">
        <div style="font-size: 2rem; font-weight: 800; color: var(--warning);"><%= @metrics[:topics_this_month] %></div>
        <div style="color: var(--text-secondary); font-size: 0.85rem;"><%= t(".topics_this_month") %></div>
      </div>
    </div>

    <h2 class="feed-title" style="font-size: 1.2rem;"><%= t(".top_services") %></h2>
    <% if @metrics[:top_services].any? %>
      <% @metrics[:top_services].each_with_index do |service, index| %>
        <div class="service-card">
          <div class="service-left">
            <span class="service-category"><%= t("categories.#{service.category}", default: service.category) %></span>
            <h3 class="service-title"><%= index + 1 %>. <%= service.title %></h3>
            <p class="service-desc"><%= service.description %></p>
          </div>
          <div class="service-vouch">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--success);"><%= service.upvotes_count %> <%= t("dashboard.index.vouches") %></span>
          </div>
        </div>
      <% end %>
    <% else %>
      <p style="color: var(--text-secondary);"><%= t(".no_services") %></p>
    <% end %>

    <h2 class="feed-title" style="font-size: 1.2rem; margin-top: 2rem;"><%= t(".recent_announcements") %></h2>
    <% if @metrics[:recent_announcements].any? %>
      <% @metrics[:recent_announcements].each do |announcement| %>
        <div class="post-card">
          <%= link_to announcement.title, topic_path(announcement), class: "post-title", style: "color: inherit; text-decoration: none;" %>
          <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">
            <%= time_ago_in_words(announcement.created_at) %> <%= t("dashboard.index.ago") %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p style="color: var(--text-secondary);"><%= t(".no_announcements") %></p>
    <% end %>

    <div style="margin-top: 2rem;">
      <%= link_to t(".back"), dashboard_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
